<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:client.ViewModels"
             x:Class="client.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid ColumnDefinitions="260, *" Background="#EEF2F6">
        
        <!-- LEFT NAVIGATION RAIL (Dark Slate #1A202C) -->
        <Border Grid.Column="0" Background="#1A202C" BorderBrush="#2D3748" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, *, Auto" Margin="16">
                
                <!-- Workspace Header -->
                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="#718096" LetterSpacing="1.5"/>
                    <TextBlock Text="Control Rail" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                </StackPanel>

                <!-- Navigation Items -->
                <StackPanel Grid.Row="1" Spacing="6">
                    <!-- Active Item (Purple Accent) -->
                    <Border Background="#7C3AED" CornerRadius="6" Padding="12,10">
                        <TextBlock Text="Dashboard" FontWeight="Medium" Foreground="White"/>
                    </Border>
                    <Button Content="Saved Devices (4)" Background="Transparent" Foreground="#A0AEC0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10"/>
                    <Button Content="Recent Sessions" Background="Transparent" Foreground="#A0AEC0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10"/>
                    <Button Content="File Transfer" Background="Transparent" Foreground="#A0AEC0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10"/>
                    <Button Content="Settings" Background="Transparent" Foreground="#A0AEC0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10"/>
                </StackPanel>

                <!-- Bottom Mesh Status Widget -->
                <Border Grid.Row="2" Background="#111827" CornerRadius="8" Padding="12" BorderBrush="#2D3748" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="MESH STATUS" FontSize="10" FontWeight="Bold" Foreground="#718096"/>
                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="#10B981"/>
                        </Grid>
                        <TextBlock Text="TLS 1.3 / ChaCha20" FontSize="11" Foreground="#CBD5E1"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT CANVAS -->
        <ScrollViewer Grid.Column="1" Padding="32">
            <StackPanel Spacing="24">
                
                <!-- Section Header -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Remote Access" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
                            <Border Background="#EDE9FE" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="MESH v2.4" FontSize="10" FontWeight="Bold" Foreground="#7C3AED"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Connect to remote computers or share your screen securely with hardware-accelerated pipeline." FontSize="13" Foreground="#64748B"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="Mesh Node Map" Background="White" Foreground="#0D9488" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14,8"/>
                        <Button Content="+ Add Device" Background="#7C3AED" Foreground="White" CornerRadius="6" Padding="14,8"/>
                    </StackPanel>
                </Grid>

                <!-- DUAL CONNECTION CARDS (50/50 Grid) -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                    
                    <!-- Left Card: Workstation Titan (Local Host) -->
                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Column="0" Width="36" Height="36" Background="#CCFBF1" CornerRadius="8">
                                    <TextBlock Text="🖥" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Workstation Titan" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <TextBlock Text="Arch Linux • Wayland • 192.168.1.84" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#ECFDF5" CornerRadius="12" Padding="8,4" VerticalAlignment="Top">
                                    <TextBlock Text="● READY" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                                </Border>
                            </Grid>

                            <Separator Background="#F1F5F9" Height="1"/>

                            <!-- Your Machine ID Box -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="YOUR MACHINE ID" FontSize="10" FontWeight="Bold" Foreground="#64748B" LetterSpacing="1"/>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBox Grid.Column="0" Text="{Binding LocalId}" IsReadOnly="True" FontSize="18" FontWeight="Bold" Height="42" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Copy ID" Command="{Binding CopyIdCommand}" Margin="8,0,0,0" Background="#EEF2F6" Foreground="#334155" Height="42" VerticalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <!-- Footer note -->
                            <TextBlock Text="🔒 End-to-end encrypted • Zero-Trust Protocol" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Right Card: Control Remote Device -->
                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Column="0" Width="36" Height="36" Background="#EEF2F6" CornerRadius="8">
                                    <TextBlock Text="⚡" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Control Remote Device" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <TextBlock Text="Tunnel: WebRTC Direct P2P + Relay" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#EEF2F6" CornerRadius="12" Padding="8,4" VerticalAlignment="Top">
                                    <TextBlock Text="ACTIVE ENGINE" FontSize="10" FontWeight="Bold" Foreground="#4F46E5"/>
                                </Border>
                            </Grid>

                            <Separator Background="#F1F5F9" Height="1"/>

                            <!-- Target ID Input -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="PARTNER MACHINE ID" FontSize="10" FontWeight="Bold" Foreground="#64748B" LetterSpacing="1"/>
                                <TextBox Watermark="e.g. 512 409 119" Text="{Binding TargetId}" Height="40" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- Checkboxes -->
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <CheckBox Content="Unattended elevation" IsChecked="{Binding RequestElevation}"/>
                                <CheckBox Content="Clipboard sync" IsChecked="{Binding ClipboardSync}"/>
                            </StackPanel>

                            <!-- Connect CTA Button -->
                            <Button Content="Connect Now ➔" Command="{Binding ConnectCommand}" Background="#2563EB" Foreground="White" HorizontalAlignment="Stretch" Height="42" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold" CornerRadius="6"/>
                            
                            <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" Foreground="#475569" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>